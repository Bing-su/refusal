{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/com.openai/hooks/refusal.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%/com.openai/hooks/refusal.mjs\"",
            "timeout": 5,
            "statusMessage": "Loading Refusal principles"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/com.openai/hooks/refusal.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%/com.openai/hooks/refusal.mjs\"",
            "timeout": 5,
            "statusMessage": "Refreshing Refusal judgment"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/com.openai/hooks/refusal.mjs\"",
            "commandWindows": "node \"%PLUGIN_ROOT%/com.openai/hooks/refusal.mjs\"",
            "timeout": 5,
            "statusMessage": "Loading Refusal principles for subagent"
          }
        ]
      }
    ]
  }
}
